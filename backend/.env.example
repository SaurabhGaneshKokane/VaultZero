# ============================================================================
# VaultZero Lite - Backend Environment Configuration
# ============================================================================

# Server Port and Host
PORT=8000
HOST=0.0.0.0

# Storage Directory for client-encrypted .vault files (ephemeral local storage)
VAULT_STORAGE_DIR=backend/storage

# Maximum permitted encrypted package size in bytes (default: 50MB)
MAX_FILE_SIZE_BYTES=52428800

# Allowed CORS Origins (comma-separated list, e.g., http://localhost:3000,https://my-vaultzero.vercel.app)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://*.vercel.app

# ============================================================================
# Supabase PostgreSQL Configuration (Public Key Directory)
# ============================================================================
# When configured, the backend stores registered public keys and directory records in Supabase PostgreSQL.
# If omitted or empty, the backend automatically uses an SQLite local fallback database (backend/storage/vaultzero.db).
#
# IMPORTANT SECURITY INVARIANT:
# The Supabase SERVICE-ROLE key must NEVER be exposed to the client or committed to git.
# Run the SQL migration in 'backend/migrations/001_create_public_keys_schema.sql' in your Supabase project.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key-do-not-expose-to-frontend

